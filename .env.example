# =========================================================
# Local development defaults
# =========================================================
POSTGRES_USER=integrity
POSTGRES_PASSWORD=integrity_dev_password
POSTGRES_DB=integrity_learning
POSTGRES_PORT=5432

BACKEND_PORT=4000
FRONTEND_PORT=3000

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.gov
PGADMIN_DEFAULT_PASSWORD=admin_dev_password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
MAX_ACTIVE_SESSIONS=5
COOKIE_NAME=integrity_token
INITIAL_ADMIN_EMAIL=admin@example.gov
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# SMTP used for invitations and password recovery.
# These defaults use the local Mailpit container. Replace them in production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@seseay.local
MAILPIT_PORT=8025

# Local frontend/backend URLs
COOKIE_SECURE=false
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000/api

# =========================================================
# Production deployment
# Fill these before running docker-compose.prod.yml
# =========================================================

# Public domain without protocol.
# Example: capacitacion.tudominio.gob.mx
APP_DOMAIN=capacitacion.example.gov

# Public app URL with https://
# This is used by the backend CORS configuration.
# Example: https://capacitacion.tudominio.gob.mx
PUBLIC_APP_URL=https://capacitacion.example.gov

# Public API URL used at frontend build time.
# If the API is served by the same domain through Caddy, keep exactly /api.
# Do not use https:// by itself. Do not add a trailing slash.
# If using a separate API domain, use https://api.tudominio.gob.mx/api
PUBLIC_API_URL=/api

# Email used by Caddy/Let's Encrypt for TLS certificates.
ACME_EMAIL=admin@example.gov

# Production must use a long random value.
# Example generation:
# openssl rand -base64 48
# JWT_SECRET=PASTE_RANDOM_SECRET_HERE
